# faynoSync configuration for local development and CI.
#
# Running the API from source: cp .env.example .env
# Docker Compose reads this file directly and overrides only the hostnames
# (MONGODB_URL, REDIS_HOST, S3_API_ENDPOINT, ONLINE_KEY_DIR) in the backend service of docker-compose.yaml.
#
# The values below are public and for local use only. Full reference:
# https://faynosync.com/docs/getting-started/env-overview
#
# Keep comments on their own lines: Compose and the API parse trailing comments differently.

################### Server ###################

# Port the API listens on.
PORT=9000
# Public URL of the API; used to build private download links (API_URL/download?key=...).
API_URL=http://localhost:9000
# Browser origins allowed to call the API. The dashboard at /dashboard/ is same-origin and needs no entry.
ALLOWED_CORS=chrome-extension://fhdpldnibaocgjobfdkikidckofodicc
# IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For for the /login and /signup rate limits.
# Unset trusts every proxy (client IP spoofable). An invalid value stops the server on startup.
# TRUSTED_PROXIES=127.0.0.1,::1

################### Security ###################

# Signup secret for creating admin accounts. Empty disables /signup.
# Local/CI only. For any other deployment: openssl rand -base64 16
API_KEY=insecure-dev-api-key
# Signs JWT tokens. Must be at least 32 bytes; the API refuses to start otherwise.
# Local/CI only. For any other deployment: openssl rand -base64 32
JWT_SECRET=insecure-dev-jwt-secret-do-not-use-in-production

################### MongoDB ###################

MONGODB_URL=mongodb://root:MheCk6sSKB1m4xKNw5I@localhost/cb_faynosync_db?authSource=admin
# Database used by the integration tests.
MONGODB_URL_TESTS=mongodb://root:MheCk6sSKB1m4xKNw5I@localhost/cb_faynosync_db_tests?authSource=admin

################### Redis (required) ###################

# Response cache, telemetry counters, TUF task state and rate limits. The API exits if Redis is unreachable.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Cache update-check responses in Redis.
PERFORMANCE_MODE=true

################### Storage: Garage (local S3-compatible) ###################

# aws, gcp, digitalocean, or minio (deprecated). Garage and other S3-compatible providers use aws.
STORAGE_DRIVER=aws
# These credentials are imported automatically by the Compose Garage bootstrap.
S3_ACCESS_KEY=GK8fcbbed327a9ff97f250eb4e
S3_SECRET_KEY=8a59fe92499699d139fcee6998343dad2ac73fb2b5dffafa0a7d0b0d4e305db9
S3_REGION=us-east-1
# Region of the private bucket, only when it differs from S3_REGION.
# S3_REGION_PRIVATE=
# Public bucket: artifacts of public apps.
S3_BUCKET_NAME=cb-faynosync-s3-public
# Private bucket: artifacts of private apps and report blobs.
S3_BUCKET_NAME_PRIVATE=cb-faynosync-s3-private
# Bucket for edge manifests of apps with cdn=true; can be the public bucket.
S3_BUCKET_NAME_CDN=cb-faynosync-s3-public
# Public URLs of the buckets, used in artifact links.
S3_ENDPOINT=http://cb-faynosync-s3-public.web.garage.localhost:3902
S3_ENDPOINT_PRIVATE=http://cb-faynosync-s3-private.web.garage.localhost:3902
# S3 API endpoint for S3-compatible providers. Leave empty for AWS S3.
S3_API_ENDPOINT=http://127.0.0.1:3900
# Path-style requests and no object ACLs, as Garage requires.
S3_FORCE_PATH_STYLE=true
S3_DISABLE_OBJECT_ACL=true
# Lifetime of presigned upload URLs (max 168h).
PRESIGNED_UPLOAD_URL_TTL=30m

################### Storage: other providers ###################

# AWS S3
# STORAGE_DRIVER=aws
# S3_ENDPOINT=https://<public-bucket>.s3.amazonaws.com
# S3_ENDPOINT_PRIVATE=https://<private-bucket>.s3.amazonaws.com
# S3_API_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_DISABLE_OBJECT_ACL=false

# DigitalOcean Spaces
# STORAGE_DRIVER=digitalocean
# S3_REGION=nyc3
# S3_ENDPOINT=nyc3.digitaloceanspaces.com
# S3_ENDPOINT_PRIVATE=nyc3.digitaloceanspaces.com

# Google Cloud Storage
# STORAGE_DRIVER=gcp
# GCS_CREDENTIALS_FILE=/path/to/credentials.json
# GCS_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n

# MinIO (deprecated, still works but is no longer maintained)
# STORAGE_DRIVER=minio
# MINIO_SECURE=false
# S3_ENDPOINT=localhost:9010
# S3_ENDPOINT_PRIVATE=localhost:9010

################### Features ###################

# Default download_mode for new private apps: true = unlisted, false = strict. Deprecated.
ENABLE_PRIVATE_APP_DOWNLOADING=false
# Collect update-check telemetry.
ENABLE_TELEMETRY=true
# Maximum number of version ids in one DELETE /apps/delete request.
MAX_BULK_DELETE_VERSIONS=10

################### Dashboard ###################

# Serve the admin dashboard at /dashboard/.
DASHBOARD_ENABLED=true
# Pre-fills the TUF metadata URL in the dashboard's key generation form.
DASHBOARD_TUF_METADATA_URL=http://cb-faynosync-s3-public.web.garage.localhost:3902/tuf_metadata/

################### TUF ###################

# Signed TUF metadata for apps that are bootstrapped for it.
TUF_ENABLED=true
# Directory with the online signing keys (targets, snapshot, timestamp). Root keys stay offline.
ONLINE_KEY_DIR=./tuf_keys/private_keys

################### Reports ###################

# Crash/event reporting API. Report blobs are stored in the private bucket.
REPORTS_ENABLED=true
REPORTS_MAX_BODY_BYTES=262144
REPORTS_MAX_DETAILS_COMPRESSED_BYTES=131072
REPORTS_MAX_DETAILS_DECOMPRESSED_BYTES=1048576
# Applied per blob at insert time, not by a Mongo TTL index.
REPORTS_BLOB_RETENTION_DAYS=30
REPORTS_MAX_BLOBS_PER_GROUP=10
REPORTS_STORAGE_PREFIX=reports
# Per-key ingest limit; per-group 30/min and per-device+group 1/hour are fixed.
REPORTS_RATE_LIMIT_PER_KEY_PER_MINUTE=100

################### Slack ###################

SLACK_ENABLE=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_NOTIFICATION_TTL=24h
